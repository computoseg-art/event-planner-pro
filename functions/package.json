{
  "name": "event-planner-pro-functions",
  "description": "Firebase Cloud Functions for Event Planner Pro",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test 'lib/**/*.test.js'",
    "lint": "eslint ."
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^6.6.0",
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "mercadopago": "^2.5.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "typescript": "^5.9.2",
    "eslint": "^8.42.0"
  }
}
